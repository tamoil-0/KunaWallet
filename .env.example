# ===== KUNA WALLET — Environment Variables =====

# PostgreSQL database (Vercel Postgres / Neon)
# Get this from: https://vercel.com/dashboard → Storage → Postgres
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# JWT secret for authentication (any 32+ char random string)
JWT_SECRET=your_super_secret_jwt_minimum_32_characters_long

# OpenAI API key for Kuna AI chat
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# CoinGecko (optional — works without key with rate limits)
# COINGECKO_API_KEY=CG-...
